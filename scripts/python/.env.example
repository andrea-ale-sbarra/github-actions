# Copy this file to `.env` and fill in your credentials.
# `.env` is gitignored, never commit real secrets.

# Jira API credentials
JIRA_API_USER=your.name@liferay.com
JIRA_API_TOKEN=your_jira_api_token_here

# Testray OAuth2 client credentials
TESTRAY_CLIENT_ID=your_testray_client_id_here
TESTRAY_CLIENT_SECRET=your_testray_client_secret_here

# Jira epic key under which investigation tasks will be filed as subtasks.
# Required. Example: EPIC_KEY=LPD-73638
EPIC_KEY=LPD-XXXXX

# Jira labels used to tag and filter routine tickets.
# Use team-specific values (e.g. commerce_routine_tasks, commerce_out_rc)
# so different teams don't see each other's tickets.
ROUTINE_LABEL=routine_tasks
OUT_RC_LABEL=out_rc

# Fallback Jira component used when the Testray component name doesn't exist in
# the LPD project (or can't be created by your user). Required for projects that
# have Components as a mandatory field. Use the exact component name as it
# appears in Jira (e.g. "Commerce > Core" or just "Commerce").
FALLBACK_COMPONENT=

# GitHub token used by the PR review check (--check-pr-failures and the
# `*_check_failures` label flow during the main run). The check only hits
# the public `/repos/{owner}/{repo}/compare/{base}...{head}` endpoint, so
# any valid PAT works — no scopes need to be selected. Authenticating
# lifts the rate limit from 60 req/h to 5000 req/h.
#
# Optional: if left empty, the GitHub API is hit unauthenticated.
GITHUB_TOKEN=
